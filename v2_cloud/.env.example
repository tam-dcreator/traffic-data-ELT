# V2 cloud runtime configuration.
# Copy this file to ".env" inside v2_cloud/.
# Never commit the real ".env" file.

# ── AWS / S3 (Bronze ingestion) ───────────────────────────────────────────────
# AWS credentials are NOT set here. boto3 resolves them via its standard
# provider chain (environment, shared credentials/config file, or IAM role).
# Only non-secret configuration belongs below.

# AWS region of the existing S3 bucket (required for V2 Bronze ingestion).
AWS_REGION=eu-central-1
# Name of the existing S3 bucket. This project never creates the bucket.
S3_BUCKET=change_me
# Key prefix for the Bronze layer (optional; default: bronze).
S3_BRONZE_PREFIX=bronze

# Transfer tuning (optional). Defaults shown; safe to leave unset.
# Multipart part size and threshold in bytes (default: 8 MiB each).
S3_MULTIPART_CHUNK_BYTES=8388608
S3_MULTIPART_THRESHOLD_BYTES=8388608
# HTTP streaming chunk size in bytes (default: 1 MiB).
HTTP_STREAM_CHUNK_BYTES=1048576

# Optional override for the opt-in Bronze smoke test source URL.
# SMOKE_TEST_URL=https://example.com/small-file.txt
