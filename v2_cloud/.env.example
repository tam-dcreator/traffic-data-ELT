# V2 cloud runtime configuration.
# Copy this file to ".env" inside v2_cloud/.
# Never commit the real ".env" file.

# ── Authentication ────────────────────────────────────────────────────────────
# Databricks credentials are NEVER stored here.
# Authenticate once with the Databricks CLI:
#
#   databricks auth login --host https://<workspace-host>
#
# Verify authentication:
#
#   databricks current-user me
#
# The Databricks SDK and databricks-connect both pick up the resulting
# profile automatically.  No token or secret belongs in this file.

# ── AWS / S3 (Bronze ingestion) ───────────────────────────────────────────────
# AWS credentials are NOT set here. boto3 resolves them via its standard
# provider chain (environment, shared credentials/config file, or IAM role).
# Only non-secret configuration belongs below.

# AWS region of the existing S3 bucket (required for V2 Bronze ingestion).
AWS_REGION=eu-central-1
# Name of the existing S3 bucket. This project never creates the bucket.
S3_BUCKET=change_me
# Key prefix for the Bronze layer (optional; default: bronze).
S3_BRONZE_PREFIX=bronze
# Key prefix for the Silver layer (optional; default: silver).
S3_SILVER_PREFIX=silver
# Key prefix for the Gold layer (optional; default: gold).
S3_GOLD_PREFIX=gold

# Transfer tuning (optional). Defaults shown; safe to leave unset.
# Multipart part size and threshold in bytes (default: 8 MiB each).
S3_MULTIPART_CHUNK_BYTES=8388608
S3_MULTIPART_THRESHOLD_BYTES=8388608
# HTTP streaming chunk size in bytes (default: 1 MiB).
HTTP_STREAM_CHUNK_BYTES=1048576

# Optional override for the opt-in Bronze smoke test source URL.
# SMOKE_TEST_URL=https://example.com/small-file.txt

# ── Databricks workspace ──────────────────────────────────────────────────────
# Authentication is handled by the Databricks CLI OAuth profile (~/.databrickscfg),
# not by a token here. Leave DATABRICKS_HOST UNSET/commented so that sourcing this
# file does not override the working CLI profile. Only set it (to a real host) if
# you explicitly need to override the default profile for a non-interactive tool.
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# ── Unity Catalog temporary volume ───────────────────────────────────────────
# UC volume used for temporary extraction during Silver pipeline runs.
# Pre-create once with:
#   CREATE VOLUME IF NOT EXISTS <catalog>.<schema>.<volume>;
#
# Files are removed after successful Silver validation.
# The volume itself is NOT part of the durable data architecture.
UC_CATALOG=workspace
UC_SCHEMA=default
UC_VOLUME=v2_temp

# ── Databricks Connect (optional, local Spark via serverless) ─────────────────
# Serverless compute requires databricks-connect >= 15.1.
# No cluster ID is needed for the serverless path.
# See README for setup steps.
# DATABRICKS_SERVERLESS_COMPUTE_ID=auto   # uncomment for explicit serverless

# ── Neon (V2 serving warehouse) ───────────────────────────────────────────────
# The `neon` CLI reads its API key from NEON_API_KEY, which avoids the browser
# OAuth flow (xdg-open) that cannot complete in a headless dev container.
# Create the key in the Neon console (Account settings → API keys) and paste it
# below.  This is a SECRET — it lives only in the untracked v2_cloud/.env, never
# in this committed .env.example and never in the repository.
NEON_API_KEY=change_me

# ── Neon PostgreSQL connection (serving DB) ───────────────────────────────────
# Connection parameters for the Neon serving database, used later by the shared
# dbt project (Neon target) and psycopg loaders.  Retrieve them from the Neon
# console or via:  neon connection-string <branch>
# NEON_DB_PASSWORD is a SECRET and must never be committed — fill it in only in
# the untracked v2_cloud/.env, not here.
#
# Placeholders below are intentionally NOT a valid host/user/password tuple so
# no scanner mistakes them for real credentials.  Replace <...> in your .env.
NEON_DB_HOST=<your-endpoint>.<region>.aws.neon.tech
NEON_DB_PORT=5432
NEON_DB_NAME=<your-database>
NEON_DB_USER=<your-role>
NEON_DB_PASSWORD=<set-in-untracked-.env>
# Neon requires TLS; keep sslmode=require.
NEON_DB_SSLMODE=require
# Optional: Neon compute endpoint / branch identifiers for reference.
# NEON_PROJECT_ID=<your-project-id>
# NEON_BRANCH=production
