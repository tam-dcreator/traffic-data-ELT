# V1 local runtime configuration.
# Copy this file to ".env" inside v1_local/.
# Never commit the real ".env" file.

# ── PostgreSQL superuser (used only for initialisation) ──────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me


# ── traffic_dwh database ─────────────────────────────────────────────────────
TRAFFIC_DB_NAME=traffic_dwh
TRAFFIC_DB_USER=traffic_user
TRAFFIC_DB_PASSWORD=change_me
# Traffic warehouse connection used by shared Python ingestion code.
TRAFFIC_DB_HOST=postgres
TRAFFIC_DB_PORT=5432

# ── airflow_meta database ────────────────────────────────────────────────────
AIRFLOW_DB_NAME=airflow_meta
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=change_me

# ── redash_meta database ─────────────────────────────────────────────────────
REDASH_DB_NAME=redash_meta
REDASH_DB_USER=redash_user
REDASH_DB_PASSWORD=change_me

# ── Airflow ──────────────────────────────────────────────────────────────────
# UID of the user running Airflow inside the container (run: id -u).
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Fernet key for encrypting connections/variables (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=change_me

# ── Ingestion ────────────────────────────────────────────────────────────────
# Path inside Airflow containers where pNEUMA sample CSV files are mounted.
TRAFFIC_DATA_DIR=/data/sample
# Set to a positive integer to limit rows per file (0 = no limit).
TRAFFIC_INGEST_ROW_LIMIT=0

# ── Redash ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REDASH_SECRET_KEY=change_me
REDASH_COOKIE_SECRET=change_me
