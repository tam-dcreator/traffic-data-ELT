# V1 local runtime configuration.
# Copy this file to ".env" inside v1_local/.
# Never commit the real ".env" file.

# PostgreSQL
POSTGRES_DB=traffic_dwh
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Redash
REDASH_SECRET_KEY=change_me
REDASH_COOKIE_SECRET=change_me